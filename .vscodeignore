# VSCE packages the workspace minus these patterns (see also package.json — do not use both "files" and .vscodeignore).

.vscode/**
.vscode-test/**
.cursor/**
.git/**
.github/**
.dev/**
.tmp/**
.my-ai-extension/**
.output/**
.vsix/**

# TypeScript source; runtime entry is the esbuild bundle only
src/**
tsconfig.json

node_modules/**

*.vsix

# tsc output under dist/ is not shipped; vscode:prepublish produces dist/extension.js only
dist/**
!dist/extension.js

# Build, lint, typecheck, and headless tests — not used at extension runtime
scripts/**
esbuild.mjs
eslint.config.mjs
tsconfig.webview.json

# Repo / packaging noise
.gitignore
**/*.map
License

# Not required inside the VSIX for runtime
package-lock.json

# Developer docs (generated settings table, etc.) — not needed at runtime
docs/**

# Local scratch / planning markdown (not extension assets)
crawler_plan.md
hello_note*.md
dependency_target.md
hello_semantics_ok.md
multi_step_a.md
